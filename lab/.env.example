# Copy to lab/.env (git-ignored). Any OpenAI-compatible endpoint works.
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
# Nebius:      LLM_BASE_URL=https://api.studio.nebius.ai/v1
# DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1
# Local:       LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4.1-mini
LLM_TEMPERATURE_AGENT=0.2
LLM_TEMPERATURE_JUDGE=0.0
LLM_TIMEOUT_S=60
# Optional. LLM_MAX_TOKENS: reply limit per call (default 600; 1500 for verbose models).
# LLM_ENV_FILE: another key file to load instead of lab/.env (for example lab/.env.openrouter).
# LLM_EXTRA_JSON: extra request fields, for example {"thinking": {"type": "disabled"}} for DeepSeek V4.
# LLM_MAX_TOKENS=600
# LLM_EXTRA_JSON=
